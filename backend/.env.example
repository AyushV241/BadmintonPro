# Copy to backend/.env (gitignored) and fill in. Loaded on startup, before the
# repo-root .env; anything already set in your shell takes precedence over both.

# Shared hosted Postgres. Use the provider's *direct* (non-pooled) connection
# string; `go run . -migrate` needs a direct session.
# Leave unset to use the local Docker database from docker-compose.yml.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Google sign-in. These can live here or in the repo-root .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Session cookie `Secure` flag. false for http://localhost, true behind HTTPS.
COOKIE_SECURE=false
